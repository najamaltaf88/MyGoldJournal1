# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Server-only Supabase service-role key. Never expose as VITE_* or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe Supabase anon/publishable key. This is intentionally VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase PostgreSQL connection used by Drizzle. Use the transaction pooler
# (port 6543) for Netlify Functions. Use the session pooler (port 5432) for
# drizzle-kit migrations and one-time data import/verification scripts.
# Keep this server-only; never prefix it with VITE_.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Required to encrypt MT5 API keys at rest. Preserve the existing value when
# migrating an existing installation; changing it makes old encrypted keys unreadable.
MT5_ENCRYPTION_KEY=

# Private Supabase Storage bucket for screenshots and MT5 assets.
SUPABASE_STORAGE_BUCKET=journal-assets
# Object key uploaded to the bucket for the MT5 EA download endpoint.
SUPABASE_EA_ASSET_KEY=mt5/GoldJournal_EA.mq5

# Legacy source database used only by scripts/export-mysql-data.ts during migration.
# MYSQL_DATABASE_URL=
# Optional path to the JSON export used by import/verification scripts.
# MYSQL_EXPORT_FILE=./migration/mysql-export.json

# Optional analytics. Leave both blank to disable analytics.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
